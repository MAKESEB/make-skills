{
  "baseUrl": "https://rest.ably.io",
  "headers": {
    "Authorization": "Basic {{base64(connection.keyName + ':' + connection.keySecret)}}",
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "response": {
    "error": {
      "401": {
        "message": "[401] Authentication failed. Check your Ably credentials."
      },
      "403": {
        "message": "[403] Access denied. Check your Ably permissions."
      },
      "404": {
        "message": "[404] Resource not found."
      },
      "message": "[{{statusCode}}] {{body.error.message || body.message || body.error || 'Request failed'}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization",
      "request.headers.key",
      "request.body.clientKey",
      "request.qs.api_key"
    ]
  }
}
