[
  {
    "name": "domainId",
    "type": "select",
    "label": "Domain",
    "required": true,
    "options": "rpc://listDomains"
  },
  {
    "name": "fields",
    "type": "text",
    "label": "Fields",
    "default": "id,keyword,ranks.rank,ranks.created_at,search_volume,share_of_voice",
    "required": true,
    "help": "AccuRanker Read API requires the fields query parameter; nested fields use dot notation."
  },
  {
    "name": "periodFrom",
    "type": "date",
    "label": "Period From"
  },
  {
    "name": "periodTo",
    "type": "date",
    "label": "Period To"
  },
  {
    "name": "filterId",
    "type": "number",
    "label": "API Filter ID"
  },
  {
    "name": "limit",
    "type": "number",
    "label": "Limit",
    "default": 100,
    "minimum": 1,
    "maximum": 200
  },
  {
    "name": "offset",
    "type": "number",
    "label": "Offset",
    "default": 0,
    "minimum": 0
  }
]
