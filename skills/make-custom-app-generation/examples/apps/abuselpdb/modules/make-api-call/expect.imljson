[
  {
    "name": "url",
    "type": "text",
    "label": "Path",
    "required": true,
    "default": "/check",
    "help": "Relative AbuseIPDB API v2 path, for example /check, /report, /reports, /blacklist, /check-block, or /clear-address."
  },
  {
    "name": "method",
    "type": "select",
    "label": "Method",
    "required": true,
    "default": "GET",
    "options": [
      {
        "label": "GET",
        "value": "GET"
      },
      {
        "label": "POST",
        "value": "POST"
      },
      {
        "label": "PUT",
        "value": "PUT"
      },
      {
        "label": "PATCH",
        "value": "PATCH"
      },
      {
        "label": "DELETE",
        "value": "DELETE"
      }
    ]
  },
  {
    "name": "headers",
    "type": "array",
    "label": "Headers",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ],
    "help": "Additional headers only. Do not add the Key header; the app sends it from the connection."
  },
  {
    "name": "querystring",
    "type": "array",
    "label": "Query String",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ]
  },
  {
    "name": "body",
    "type": "any",
    "label": "Body",
    "help": "Optional request body for POST, PUT, and PATCH requests. Do not add the Key header; the app sends it from the connection."
  }
]
