{
  "url": "/getUsers",
  "method": "GET",
  "qs": {
    "ResultsPerPage": 100,
    "Page": "{{pagination.page}}"
  },
  "response": {
    "iterate": "{{body.Users}}",
    "output": {
      "label": "{{trim((item.FirstName || '') + ' ' + (item.LastName || '')) || item.Email || item.Id}}",
      "value": "{{item.Id}}"
    }
  },
  "pagination": {
    "condition": "{{body.Records.Page < body.Records.Pages}}",
    "qs": {
      "Page": "{{pagination.page}}"
    }
  }
}
