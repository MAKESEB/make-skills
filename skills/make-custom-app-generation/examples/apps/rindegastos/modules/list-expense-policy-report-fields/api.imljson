{
  "url": "/getExpensePolicyExpenseReportFields",
  "method": "GET",
  "qs": {
    "IdPolicy": "{{parameters.IdPolicy}}",
    "OrderBy": "{{if(parameters.OrderBy != null, parameters.OrderBy, undefined)}}",
    "Order": "{{if(parameters.Order != null, parameters.Order, undefined)}}"
  },
  "response": {
    "iterate": "{{body.ExpenseExtraFields}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  }
}
