[
  {
    "name": "url",
    "type": "text",
    "label": "Path",
    "required": true,
    "help": "Relative Rinde Gastos API path, for example /getExpenses."
  },
  {
    "name": "method",
    "type": "select",
    "label": "Method",
    "options": [
      {
        "label": "GET",
        "value": "GET"
      },
      {
        "label": "POST",
        "value": "POST"
      },
      {
        "label": "PUT",
        "value": "PUT"
      },
      {
        "label": "PATCH",
        "value": "PATCH"
      },
      {
        "label": "DELETE",
        "value": "DELETE"
      }
    ],
    "required": true,
    "default": "GET"
  },
  {
    "name": "headers",
    "type": "array",
    "label": "Headers",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ],
    "help": "Additional headers only. Do not add Authorization here."
  },
  {
    "name": "qs",
    "type": "array",
    "label": "Query String",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ]
  },
  {
    "name": "body",
    "type": "any",
    "label": "Body",
    "help": "Optional request body for POST, PUT, and PATCH requests."
  }
]
