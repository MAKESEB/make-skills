[
  {
    "name": "laufendeNummer",
    "type": "text",
    "label": "Case File Number",
    "required": true
  },
  {
    "name": "bezugsJahr",
    "type": "number",
    "label": "Reference Year",
    "required": true
  },
  {
    "name": "id",
    "type": "select",
    "label": "ID",
    "required": true,
    "options": "rpc://getDocuments?laufendeNummer={{parameters.laufendeNummer}}&bezugsJahr={{parameters.bezugsJahr}}",
    "mode": "edit"
  }
]
