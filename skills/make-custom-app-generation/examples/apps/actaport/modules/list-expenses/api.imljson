{
  "url": "/akten/{{parameters.laufendeNummer}}/{{parameters.bezugsJahr}}/verguetungspositionen/eigene-auslagen",
  "method": "GET",
  "qs": {
    "size": "{{if(parameters.limit < 50, parameters.limit, 50)}}",
    "page": "{{if(parameters.page != null, parameters.page, 0)}}",
    "filter": "{{parameters.filter}}",
    "sort": "{{parameters.sort}}"
  },
  "response": {
    "iterate": "{{body.content}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  },
  "pagination": {
    "condition": "{{body.last === false}}",
    "qs": {
      "page": "{{body.number + 1}}",
      "size": "{{body.size}}"
    }
  }
}
