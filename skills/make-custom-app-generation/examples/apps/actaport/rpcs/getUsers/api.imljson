{
  "url": "/benutzer",
  "method": "GET",
  "qs": {
    "page": "{{ifempty(pagination.page, 0)}}",
    "size": 25
  },
  "response": {
    "iterate": "{{body.content}}",
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.id}}"
    }
  },
  "pagination": {
    "condition": "{{body.last === false}}",
    "qs": {
      "page": "{{body.number + 1}}",
      "size": "{{body.size}}"
    }
  }
}
