[
  {
    "name": "websiteURL",
    "type": "url",
    "label": "Website URL",
    "required": true,
    "help": "Full URL of the page where the CAPTCHA is displayed."
  },
  {
    "name": "websiteKey",
    "type": "text",
    "label": "Website Key / Sitekey",
    "required": true,
    "help": "The public sitekey from the target page."
  },
  {
    "name": "minScore",
    "type": "select",
    "label": "Minimum Score",
    "default": 0.3,
    "options": [
      {
        "label": "0.3",
        "value": 0.3
      },
      {
        "label": "0.5",
        "value": 0.5
      },
      {
        "label": "0.7",
        "value": 0.7
      },
      {
        "label": "0.9",
        "value": 0.9
      }
    ]
  },
  {
    "name": "pageAction",
    "type": "text",
    "label": "Page Action"
  },
  {
    "name": "apiDomain",
    "type": "select",
    "label": "API Domain",
    "options": [
      {
        "label": "Default (google.com)",
        "value": "google.com"
      },
      {
        "label": "recaptcha.net",
        "value": "recaptcha.net"
      }
    ]
  }
]
